{
    "$schema": "./node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "app",
            "installMode": "prefetch",
            "resources": {
                "files": [
                    "/favicon.ico",
                    "/index.html",
                    "/manifest.webmanifest",
                    "/*.css",
                    "/*.js"
                ]
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/icons/**",
                    "/assets/**",
                    "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
                ]
            }
        }
    ],
    "dataGroups": [
        {
            "name": "api-pacientes",
            "urls": [
                "https://salud-casa-backend-production.up.railway.app/pacientes/**"
            ],
            "cacheConfig": {
                "maxSize": 100,
                "maxAge": "7d",
                "strategy": "freshness"
            }
        },
        {
            "name": "api-incidencias",
            "urls": [
                "https://salud-casa-backend-production.up.railway.app/incidencias/**"
            ],
            "cacheConfig": {
                "maxSize": 50,
                "maxAge": "7d",
                "strategy": "freshness"
            }
        },
        {
            "name": "api-notificaciones",
            "urls": [
                "https://salud-casa-backend-production.up.railway.app/notificaciones/**"
            ],
            "cacheConfig": {
                "maxSize": 50,
                "maxAge": "7d",
                "strategy": "freshness"
            }
        }
    ]
}